{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cursos-aph",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-10",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portal-aph-db",
      "database_id": "488bccc6-a170-4a46-8e35-13065f42454e",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "CATALOG_BACKEND": "legacy"
  }
}
